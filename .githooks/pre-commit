#!/usr/bin/env bash
# Checks staged Swift files with swift-format and SwiftLint before each commit.
# Enable with: scripts/setup.sh  (or: git config core.hooksPath .githooks)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' f; do
    files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')

[ ${#files[@]} -eq 0 ] && exit 0

status=0

if ! swift format lint --strict --parallel "${files[@]}"; then
    status=1
fi

if command -v swiftlint >/dev/null 2>&1; then
    if ! swiftlint lint --strict --quiet --force-exclude "${files[@]}"; then
        status=1
    fi
else
    echo "warning: swiftlint not installed; skipping lint (run scripts/setup.sh)" >&2
fi

if [ $status -ne 0 ]; then
    echo >&2
    echo "✗ Pre-commit checks failed. Run scripts/format.sh to auto-fix what it can, then re-stage." >&2
fi
exit $status
