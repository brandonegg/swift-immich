#!/usr/bin/env bash
#MISE description="Check staged Swift files with swift-format and SwiftLint"
set -euo pipefail

files=()
while IFS= read -r -d '' f; do
    files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')

[ ${#files[@]} -eq 0 ] && exit 0

status=0
swift format lint --strict --parallel "${files[@]}" || status=1
swiftlint lint --strict --quiet --force-exclude "${files[@]}" || status=1

if [ $status -ne 0 ]; then
    echo >&2
    echo "✗ Pre-commit checks failed. Run \`mise run format\` to auto-fix what it can, then re-stage." >&2
fi
exit $status
