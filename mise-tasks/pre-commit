#!/usr/bin/env bash
#MISE description="Check staged Swift files with swift-format and SwiftLint"
set -euo pipefail

files=()
while IFS= read -r -d '' f; do
    files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')

[ ${#files[@]} -eq 0 ] && exit 0

# Lint the staged blobs rather than the working tree, so the check matches
# exactly what will be committed. The staged lint configs come along so tool
# config lookup works the same as in the repo.
tmp=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$tmp"' EXIT
printf '%s\0' "${files[@]}" .swift-format .swiftlint.yml | git checkout-index --stdin -z --prefix="$tmp/"

staged=()
for f in "${files[@]}"; do
    staged+=("$tmp/$f")
done

# Show repo-relative paths in tool output.
relative() { sed "s#$tmp/##g"; }

status=0
swift format lint --strict --parallel "${staged[@]}" 2>&1 | relative || status=1
(cd "$tmp" && swiftlint lint --strict --quiet --force-exclude "${files[@]}") 2>&1 | relative || status=1

if [ $status -ne 0 ]; then
    echo >&2
    echo "✗ Pre-commit checks failed. Run \`mise run format\` to auto-fix what it can, then re-stage." >&2
fi
exit $status
